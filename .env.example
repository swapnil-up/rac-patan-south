# Public — baked into the browser/admin build (from app.tina.io). Safe to expose.
TINA_PUBLIC_CLIENT_ID=***
TINA_PUBLIC_BRANCH=***

# Secret — server-only, never shipped to the browser.
TINA_TOKEN=***

# Vite-compatible env vars (prefixed with VITE_) for runtime resolution
# in the generated client. Falls back to http://localhost:4001/graphql
# when not set (local dev mode).
# VITE_TINA_PUBLIC_CLIENT_ID=***
# VITE_TINA_PUBLIC_BRANCH=***
# VITE_TINA_URL=
# VITE_TINA_TOKEN=
